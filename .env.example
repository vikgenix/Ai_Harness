# Copy to .env for local development. Never commit real values.

# Required: key for the model provider (Anthropic, OpenAI, Gemini, Groq, ...)
AI_API_KEY=

# Optional: lets the harness push branches, open PRs and post issues
GITHUB_TOKEN=

# Optional overrides for config/model.yaml
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
