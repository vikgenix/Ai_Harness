{
  "name": "ai-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A coding agent that clones a GitHub repo, fixes an issue, runs the tests and commits or opens a PR.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "bin": {
    "harness": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@google/genai": "^3.4.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "openai": "^7.57.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
